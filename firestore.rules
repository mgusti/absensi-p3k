rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /attendance/{recordId} {
      allow read: if true;
      allow create, update: if isValidId(recordId) &&
        request.resource.data.nip is string && request.resource.data.nip.size() <= 30 &&
        request.resource.data.name is string && request.resource.data.name.size() <= 100 &&
        request.resource.data.session in ['Pagi', 'Sore'] &&
        request.resource.data.date is string && request.resource.data.date.size() <= 10;
      allow delete: if request.auth != null;
    }

    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isValidId(settingsId);
    }
  }
}
